# Port on the host where the app is exposed (the container always listens on 8000 internally)
HOST_PORT=8000

# Ollama base URL. Use http://host.containers.internal:11434 if Ollama runs on the host
# and the app runs in a container (Docker Desktop / Podman). Adjust if Ollama is elsewhere.
OLLAMA_BASE_URL=http://host.containers.internal:11434
